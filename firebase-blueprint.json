{
  "entities": {
    "EnergyReading": {
      "title": "EnergyReading",
      "description": "Lettura giornaliera o oraria dei consumi elettrici estratti da e-distribuzione suddivisi per fascia F1, F2, F3.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID dell'utente proprietario"
        },
        "date": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data della lettura in formato YYYY-MM-DD"
        },
        "f1Kwh": { "type": "number", "description": "Consumo in fascia F1 (ore di punta) in kWh" },
        "f2Kwh": { "type": "number", "description": "Consumo in fascia F2 (ore intermedie) in kWh" },
        "f3Kwh": { "type": "number", "description": "Consumo in fascia F3 (ore fuori punta) in kWh" },
        "totalKwh": { "type": "number", "description": "Consumo totale giornaliero in kWh" },
        "peakKw": { "type": "number", "description": "Picco di potenza massima assorbita in kW" },
        "estimatedCostEur": { "type": "number", "description": "Costo stimato in Euro" },
        "source": {
          "type": "string",
          "enum": ["e-distribuzione-csv", "e-distribuzione-api", "manuale"],
          "maxLength": 40,
          "description": "Origine del dato"
        },
        "notes": { "type": "string", "maxLength": 240, "description": "Note opzionali" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp di creazione server" }
      },
      "required": ["ownerId", "date", "f1Kwh", "f2Kwh", "f3Kwh", "totalKwh", "peakKw", "estimatedCostEur", "source", "createdAt"]
    },
    "HomeSystemConfig": {
      "title": "HomeSystemConfig",
      "description": "Stato centralizzato e setpoint della pompa di calore Ariston, impianto a pavimento e deumidificatore NeaSmart.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "aristonMode": { "type": "string", "enum": ["riscaldamento", "raffrescamento", "acs_solo", "spento"], "maxLength": 32 },
        "aristonProfile": { "type": "string", "enum": ["eco", "comfort", "boost"], "maxLength": 24 },
        "floorFlowTemp": { "type": "number" },
        "dhwTargetTemp": { "type": "number" },
        "zoneLivingTarget": { "type": "number" },
        "zoneBedroomTarget": { "type": "number" },
        "neasmartPower": { "type": "boolean" },
        "neasmartTargetHumidity": { "type": "number" },
        "neasmartFanSpeed": { "type": "string", "enum": ["auto", "bassa", "media", "alta"], "maxLength": 16 },
        "dewPointProtection": { "type": "boolean" },
        "tariffEurPerKwh": { "type": "number" },
        "podCode": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "aristonMode", "aristonProfile", "floorFlowTemp", "dhwTargetTemp",
        "zoneLivingTarget", "zoneBedroomTarget", "neasmartPower", "neasmartTargetHumidity",
        "neasmartFanSpeed", "dewPointProtection", "tariffEurPerKwh", "podCode", "updatedAt"
      ]
    },
    "ClimateSession": {
      "title": "ClimateSession",
      "description": "Sessione di accensione riscaldamento o raffrescamento NeaSmart per data, fascia oraria, temperatura e stanze.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "mode": { "type": "string", "enum": ["riscaldamento", "raffrescamento"], "maxLength": 24 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "targetTemp": { "type": "number" },
        "rooms": { "type": "array" },
        "timeSlots": { "type": "array" },
        "vmcMax": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "mode", "startTime", "endTime", "targetTemp", "rooms", "createdAt"]
    },
    "VmcDay": {
      "title": "VmcDay",
      "description": "Stato giornaliero VMC (Ventilazione Meccanica Controllata) accesa al massimo.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "enabled": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "date", "enabled", "createdAt"]
    },
    "ElectricityBill": {
      "title": "ElectricityBill",
      "description": "Bolletta elettrica reale estratta da PDF o email fornitore (Edison Energia, Octopus Energy).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "pdfFileKey": { "type": "string", "maxLength": 80, "pattern": "^bill_elec_[a-zA-Z0-9_\\-]+$" },
        "issueDate": { "type": "string", "maxLength": 20 },
        "sortKey": { "type": "string", "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "year": { "type": "number" },
        "period": { "type": "string", "maxLength": 80 },
        "supplier": { "type": "string", "maxLength": 80 },
        "offerName": { "type": "string", "maxLength": 100 },
        "kwh": { "type": "number" },
        "punText": { "type": "string", "maxLength": 60 },
        "variableCostPerKwh": { "type": "number" },
        "canoneTv": { "type": "number" },
        "electricityOnly": { "type": "number" },
        "totalPaid": { "type": "number" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "invoiceNumber", "pdfFileKey", "issueDate", "sortKey", "year", "period",
        "supplier", "offerName", "kwh", "punText", "variableCostPerKwh",
        "canoneTv", "electricityOnly", "totalPaid", "createdAt"
      ]
    },
    "WaterBill": {
      "title": "WaterBill",
      "description": "Bolletta reale del servizio idrico (AcegasApsAmga) estratta da PDF.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "pdfFileKey": { "type": "string", "maxLength": 80, "pattern": "^bill_water_[a-zA-Z0-9_\\-]+$" },
        "issueDate": { "type": "string", "maxLength": 20 },
        "year": { "type": "number" },
        "period": { "type": "string", "maxLength": 80 },
        "cubicMeters": { "type": "number" },
        "fixedCostEur": { "type": "number" },
        "totalPaid": { "type": "number" },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "invoiceNumber", "pdfFileKey", "issueDate", "year", "period",
        "cubicMeters", "fixedCostEur", "totalPaid", "createdAt"
      ]
    },
    "TariBill": {
      "title": "TariBill",
      "description": "Avviso di pagamento TARI estratto da Gmail o inserito manualmente.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "noticeNumber": { "type": "string", "maxLength": 50 },
        "pdfFileKey": { "type": "string", "maxLength": 80, "pattern": "^bill_tari_[a-zA-Z0-9_\\-]+$" },
        "issueDate": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "year": { "type": "number" },
        "period": { "type": "string", "maxLength": 80 },
        "supplier": { "type": "string", "maxLength": 80 },
        "totalPaid": { "type": "number" },
        "paid": { "type": "boolean" },
        "source": { "type": "string", "enum": ["gmail-pdf", "manuale"], "maxLength": 20 },
        "note": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "noticeNumber", "pdfFileKey", "issueDate", "dueDate", "year", "period",
        "supplier", "totalPaid", "paid", "source", "createdAt"
      ]
    },
    "GsePayment": {
      "title": "GsePayment",
      "description": "Bonifici GSE Scambio sul Posto (acconti / conguagli fotovoltaico).",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "paymentDate": { "type": "string", "maxLength": 20 },
        "year": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["acconto", "conguaglio", "altro"], "maxLength": 24 },
        "period": { "type": "string", "maxLength": 80 },
        "amountEur": { "type": "number" },
        "kwhInjected": { "type": "number" },
        "reference": { "type": "string", "maxLength": 80 },
        "note": { "type": "string", "maxLength": 240 },
        "attachmentFileKey": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "paymentDate", "year", "paymentType", "period", "amountEur", "createdAt"
      ]
    },
    "HomeArticle": {
      "title": "HomeArticle",
      "description": "Inventario dispositivi, elettrodomestici e garanzie domestiche.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "brand": { "type": "string", "maxLength": 60 },
        "model": { "type": "string", "maxLength": 80 },
        "category": {
          "type": "string",
          "enum": ["elettrodomestici", "elettronica", "sicurezza", "fotovoltaico", "clima", "altro"],
          "maxLength": 32
        },
        "room": { "type": "string", "maxLength": 60 },
        "purchaseDate": { "type": "string", "maxLength": 20 },
        "purchasePriceEur": { "type": "number" },
        "warrantyEnd": { "type": "string", "maxLength": 20 },
        "familyWarranty": { "type": "boolean" },
        "serialNumber": { "type": "string", "maxLength": 80 },
        "specs": { "type": "string", "maxLength": 240 },
        "notes": { "type": "string", "maxLength": 240 },
        "manualFileKey": { "type": "string", "maxLength": 80 },
        "manualFileName": { "type": "string", "maxLength": 140 },
        "manualExtractText": { "type": "string", "maxLength": 12000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "name", "brand", "model", "category", "room", "familyWarranty", "createdAt"
      ]
    },
    "ProductResearch": {
      "title": "ProductResearch",
      "description": "Link e schede di prodotti salvati nella pagina Ricerche.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 1000, "pattern": "^https?://.+" },
        "title": { "type": "string", "maxLength": 160 },
        "store": { "type": "string", "maxLength": 60 },
        "category": {
          "type": "string",
          "enum": ["elettrodomestici", "elettronica", "casa_arredo", "fai_da_te", "auto", "abbigliamento", "altro"],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["da_valutare", "da_acquistare", "acquistato"],
          "maxLength": 24
        },
        "room": {
          "type": "string",
          "enum": [
            "salone",
            "cucina",
            "bagno1",
            "bagno2",
            "stanza_maurizio",
            "stanza_roberta",
            "stanza_matrimoniale"
          ],
          "maxLength": 40,
          "description": "Stanza di destinazione opzionale"
        },
        "priceEur": { "type": "number" },
        "paidPriceEur": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 1000, "pattern": "^https?://.+" },
        "brand": { "type": "string", "maxLength": 60 },
        "color": { "type": "string", "maxLength": 60 },
        "availableColors": { "type": "array" },
        "colorImages": { "type": "object", "description": "Mappa colore -> URL immagine variante" },
        "size": { "type": "string", "maxLength": 60 },
        "availableSizes": { "type": "array" },
        "model": { "type": "string", "maxLength": 80 },
        "specs": { "type": "string", "maxLength": 2000 },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "url", "title", "store", "category", "status", "createdAt"]
    },
    "VaultFile": {
      "title": "VaultFile",
      "description": "Metadati di un PDF o documento archiviato su Firestore per sincronizzazione multi-dispositivo.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "fileKey": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "maxLength": 140 },
        "mimeType": { "type": "string", "maxLength": 80 },
        "size": { "type": "number" },
        "chunkCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "fileKey", "fileName", "mimeType", "size", "chunkCount", "updatedAt"]
    },
    "VaultFileChunk": {
      "title": "VaultFileChunk",
      "description": "Frammento Base64 (< 700 KB) di un file PDF/documento salvato su Firestore.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "fileKey": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chunkIndex": { "type": "number" },
        "data": { "type": "string", "maxLength": 700000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "fileKey", "chunkIndex", "data", "createdAt"]
    },
    "AppMetaOwner": {
      "title": "AppMetaOwner",
      "description": "Puntatore al UID del proprietario autenticato sul progetto unificato gen-lang-client-0721850501.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "updatedAt"]
    },
    "AppMetaOctopusTariff": {
      "title": "AppMetaOctopusTariff",
      "description": "Esito dell'ultimo controllo automatico delle tariffe luce di mercato scritto da GitHub Actions via Admin SDK.",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "maxLength": 40 },
        "myLockedRate": { "type": "number" },
        "myFixedEurMonth": { "type": "number" },
        "currentRate": { "type": "number" },
        "competitors": { "type": "array" },
        "bestCompetitor": { "type": "object" }
      },
      "required": ["myLockedRate"]
    }
  },
  "firestore": {
    "/appMeta/owner": {
      "schema": { "$ref": "#/entities/AppMetaOwner" },
      "description": "UID del proprietario attivo per sincronizzazione automatica GitHub Actions -> Firestore"
    },
    "/appMeta/octopusTariff": {
      "schema": { "$ref": "#/entities/AppMetaOctopusTariff" },
      "description": "Ultimo confronto tariffe luce di mercato scritto da GitHub Actions"
    },
    "/users/{userId}/energyReadings/{readingId}": {
      "schema": { "$ref": "#/entities/EnergyReading" },
      "description": "Letture consumi elettrici e-distribuzione dell'utente"
    },
    "/users/{userId}/homeConfig/{configId}": {
      "schema": { "$ref": "#/entities/HomeSystemConfig" },
      "description": "Configurazione e stato in tempo reale dei sistemi Ariston e NeaSmart"
    },
    "/users/{userId}/climateLogs/{logId}": {
      "schema": { "$ref": "#/entities/ClimateSession" },
      "description": "Registro accensioni riscaldamento e raffrescamento NeaSmart per stanza e fascia oraria"
    },
    "/users/{userId}/vmcDays/{dayId}": {
      "schema": { "$ref": "#/entities/VmcDay" },
      "description": "Giorni con Ventilazione Meccanica Controllata (VMC) accesa al massimo"
    },
    "/users/{userId}/electricityBills/{billId}": {
      "schema": { "$ref": "#/entities/ElectricityBill" },
      "description": "Storico bollette elettriche salvate su Firestore"
    },
    "/users/{userId}/waterBills/{billId}": {
      "schema": { "$ref": "#/entities/WaterBill" },
      "description": "Storico bollette acqua AcegasApsAmga salvate su Firestore"
    },
    "/users/{userId}/tariBills/{billId}": {
      "schema": { "$ref": "#/entities/TariBill" },
      "description": "Storico avvisi di pagamento TARI salvati su Firestore"
    },
    "/users/{userId}/gsePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/GsePayment" },
      "description": "Bonifici GSE Scambio sul Posto (acconti/conguagli) salvati su Firestore"
    },
    "/users/{userId}/homeArticles/{articleId}": {
      "schema": { "$ref": "#/entities/HomeArticle" },
      "description": "Dispositivi ed elettrodomestici di casa con stato garanzie"
    },
    "/users/{userId}/productResearches/{researchId}": {
      "schema": { "$ref": "#/entities/ProductResearch" },
      "description": "Link e prodotti salvati nella pagina Ricerche"
    },
    "/users/{userId}/vaultFiles/{fileId}": {
      "schema": { "$ref": "#/entities/VaultFile" },
      "description": "Metadati file PDF bollette e documenti salvati su Firestore"
    },
    "/users/{userId}/vaultFileChunks/{chunkId}": {
      "schema": { "$ref": "#/entities/VaultFileChunk" },
      "description": "Frammenti Base64 dei PDF e documenti salvati su Firestore"
    }
  }
}
