# GEMINI_API_KEY: Opzionale per eventuali chiamate lato server alle API Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pubblico dell'applicazione.
APP_URL="MY_APP_URL"

# GCP_MONITORING_SERVICE_ACCOUNT: JSON Service Account Google Cloud in sola lettura (ruolo roles/monitoring.viewer) per leggere la quota reale Firestore.
GCP_MONITORING_SERVICE_ACCOUNT=""
