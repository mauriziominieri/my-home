rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEnergyReading(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'date', 'f1Kwh', 'f2Kwh', 'f3Kwh',
          'totalKwh', 'peakKw', 'estimatedCostEur', 'source', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'f1Kwh', 'f2Kwh', 'f3Kwh',
          'totalKwh', 'peakKw', 'estimatedCostEur', 'source', 'notes', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.f1Kwh is number && data.f1Kwh >= 0 && data.f1Kwh <= 500
        && data.f2Kwh is number && data.f2Kwh >= 0 && data.f2Kwh <= 500
        && data.f3Kwh is number && data.f3Kwh >= 0 && data.f3Kwh <= 500
        && data.totalKwh is number && data.totalKwh >= 0 && data.totalKwh <= 1500
        && data.peakKw is number && data.peakKw >= 0 && data.peakKw <= 50
        && data.estimatedCostEur is number && data.estimatedCostEur >= 0 && data.estimatedCostEur <= 1000
        && data.source is string && data.source.size() <= 40
        && data.source in ['e-distribuzione-csv', 'e-distribuzione-api', 'manuale']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 240))
        && data.createdAt is timestamp;
    }

    function isValidHomeConfig(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'aristonMode', 'aristonProfile', 'floorFlowTemp',
          'dhwTargetTemp', 'zoneLivingTarget', 'zoneBedroomTarget',
          'neasmartPower', 'neasmartTargetHumidity', 'neasmartFanSpeed',
          'dewPointProtection', 'tariffEurPerKwh', 'podCode', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'aristonMode', 'aristonProfile', 'floorFlowTemp',
          'dhwTargetTemp', 'zoneLivingTarget', 'zoneBedroomTarget',
          'neasmartPower', 'neasmartTargetHumidity', 'neasmartFanSpeed',
          'dewPointProtection', 'tariffEurPerKwh', 'podCode', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.aristonMode is string && data.aristonMode.size() <= 32
        && data.aristonMode in ['riscaldamento', 'raffrescamento', 'acs_solo', 'spento']
        && data.aristonProfile is string && data.aristonProfile.size() <= 24
        && data.aristonProfile in ['eco', 'comfort', 'boost']
        && data.floorFlowTemp is number && data.floorFlowTemp >= 12 && data.floorFlowTemp <= 55
        && data.dhwTargetTemp is number && data.dhwTargetTemp >= 35 && data.dhwTargetTemp <= 65
        && data.zoneLivingTarget is number && data.zoneLivingTarget >= 15 && data.zoneLivingTarget <= 30
        && data.zoneBedroomTarget is number && data.zoneBedroomTarget >= 15 && data.zoneBedroomTarget <= 30
        && data.neasmartPower is bool
        && data.neasmartTargetHumidity is number && data.neasmartTargetHumidity >= 35 && data.neasmartTargetHumidity <= 75
        && data.neasmartFanSpeed is string && data.neasmartFanSpeed.size() <= 16
        && data.neasmartFanSpeed in ['auto', 'bassa', 'media', 'alta']
        && data.dewPointProtection is bool
        && data.tariffEurPerKwh is number && data.tariffEurPerKwh >= 0.05 && data.tariffEurPerKwh <= 2.0
        && data.podCode is string && data.podCode.size() <= 32
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/energyReadings/{readingId} {
      allow get: if isOwner(userId) && isValidId(readingId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(readingId)
        && isValidEnergyReading(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(readingId)
        && isValidEnergyReading(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'date', 'f1Kwh', 'f2Kwh', 'f3Kwh', 'totalKwh', 'peakKw', 'estimatedCostEur', 'source', 'notes'
        ]);
      allow delete: if isOwner(userId) && isValidId(readingId);
    }

    match /users/{userId}/homeConfig/{configId} {
      allow get: if isOwner(userId) && isValidId(configId);
      allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(configId)
        && isValidHomeConfig(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(configId)
        && isValidHomeConfig(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'aristonMode', 'aristonProfile', 'floorFlowTemp', 'dhwTargetTemp',
          'zoneLivingTarget', 'zoneBedroomTarget', 'neasmartPower',
          'neasmartTargetHumidity', 'neasmartFanSpeed', 'dewPointProtection',
          'tariffEurPerKwh', 'podCode', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(configId);
    }
  }
}
