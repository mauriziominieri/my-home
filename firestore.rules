rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPublicReadTarget(userId) {
      return userId == 'rXdhFrSuqzaYf8SYVbmQulPqg7m1';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEnergyReading(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'date', 'f1Kwh', 'f2Kwh', 'f3Kwh',
          'totalKwh', 'peakKw', 'estimatedCostEur', 'source', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'f1Kwh', 'f2Kwh', 'f3Kwh',
          'totalKwh', 'peakKw', 'estimatedCostEur', 'source', 'notes', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.f1Kwh is number && data.f1Kwh >= 0 && data.f1Kwh <= 500
        && data.f2Kwh is number && data.f2Kwh >= 0 && data.f2Kwh <= 500
        && data.f3Kwh is number && data.f3Kwh >= 0 && data.f3Kwh <= 500
        && data.totalKwh is number && data.totalKwh >= 0 && data.totalKwh <= 1500
        && data.peakKw is number && data.peakKw >= 0 && data.peakKw <= 50
        && data.estimatedCostEur is number && data.estimatedCostEur >= 0 && data.estimatedCostEur <= 1000
        && data.source is string && data.source.size() <= 40
        && data.source in ['e-distribuzione-csv', 'e-distribuzione-api', 'manuale']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 240))
        && data.createdAt is timestamp;
    }

    function isValidHomeConfig(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'aristonMode', 'aristonProfile', 'floorFlowTemp',
          'dhwTargetTemp', 'zoneLivingTarget', 'zoneBedroomTarget',
          'neasmartPower', 'neasmartTargetHumidity', 'neasmartFanSpeed',
          'dewPointProtection', 'tariffEurPerKwh', 'podCode', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'aristonMode', 'aristonProfile', 'floorFlowTemp',
          'dhwTargetTemp', 'zoneLivingTarget', 'zoneBedroomTarget',
          'neasmartPower', 'neasmartTargetHumidity', 'neasmartFanSpeed',
          'dewPointProtection', 'tariffEurPerKwh', 'podCode', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.aristonMode is string && data.aristonMode.size() <= 32
        && data.aristonMode in ['riscaldamento', 'raffrescamento', 'acs_solo', 'spento']
        && data.aristonProfile is string && data.aristonProfile.size() <= 24
        && data.aristonProfile in ['eco', 'comfort', 'boost']
        && data.floorFlowTemp is number && data.floorFlowTemp >= 12 && data.floorFlowTemp <= 55
        && data.dhwTargetTemp is number && data.dhwTargetTemp >= 35 && data.dhwTargetTemp <= 65
        && data.zoneLivingTarget is number && data.zoneLivingTarget >= 15 && data.zoneLivingTarget <= 30
        && data.zoneBedroomTarget is number && data.zoneBedroomTarget >= 15 && data.zoneBedroomTarget <= 30
        && data.neasmartPower is bool
        && data.neasmartTargetHumidity is number && data.neasmartTargetHumidity >= 35 && data.neasmartTargetHumidity <= 75
        && data.neasmartFanSpeed is string && data.neasmartFanSpeed.size() <= 16
        && data.neasmartFanSpeed in ['auto', 'bassa', 'media', 'alta']
        && data.dewPointProtection is bool
        && data.tariffEurPerKwh is number && data.tariffEurPerKwh >= 0.05 && data.tariffEurPerKwh <= 2.0
        && data.podCode is string && data.podCode.size() <= 32
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/energyReadings/{readingId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(readingId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(readingId)
        && isValidEnergyReading(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(readingId)
        && isValidEnergyReading(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'date', 'f1Kwh', 'f2Kwh', 'f3Kwh', 'totalKwh', 'peakKw', 'estimatedCostEur', 'source', 'notes', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(readingId);
    }

    match /users/{userId}/homeConfig/{configId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(configId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(configId)
        && isValidHomeConfig(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(configId)
        && isValidHomeConfig(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'aristonMode', 'aristonProfile', 'floorFlowTemp', 'dhwTargetTemp',
          'zoneLivingTarget', 'zoneBedroomTarget', 'neasmartPower',
          'neasmartTargetHumidity', 'neasmartFanSpeed', 'dewPointProtection',
          'tariffEurPerKwh', 'podCode', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(configId);
    }

    function isValidClimateSession(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'date', 'mode', 'startTime', 'endTime',
          'targetTemp', 'rooms', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'date', 'mode', 'startTime', 'endTime',
          'targetTemp', 'rooms', 'notes', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.mode is string && data.mode.size() <= 24 && data.mode in ['riscaldamento', 'raffrescamento']
        && data.startTime is string && data.startTime.size() <= 10
        && data.endTime is string && data.endTime.size() <= 10
        && data.targetTemp is number && (data.targetTemp == 0 || (data.targetTemp >= 14 && data.targetTemp <= 30))
        && data.rooms is list && data.rooms.size() >= 1 && data.rooms.size() <= 6
        && data.rooms[0] is string
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/climateLogs/{logId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(logId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(logId)
        && isValidClimateSession(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(logId)
        && isValidClimateSession(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'date', 'mode', 'startTime', 'endTime', 'targetTemp', 'rooms', 'notes', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(logId);
    }

    function isValidElectricityBill(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'invoiceNumber', 'issueDate', 'sortKey', 'year', 'period',
          'supplier', 'offerName', 'kwh', 'punText', 'variableCostPerKwh',
          'canoneTv', 'electricityOnly', 'totalPaid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'invoiceNumber', 'issueDate', 'sortKey', 'year', 'period',
          'supplier', 'offerName', 'kwh', 'punText', 'variableCostPerKwh',
          'canoneTv', 'electricityOnly', 'totalPaid', 'note', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40
        && data.issueDate is string && data.issueDate.size() >= 8 && data.issueDate.size() <= 20
        && data.sortKey is string && data.sortKey.size() == 7 && data.sortKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.period is string && data.period.size() >= 1 && data.period.size() <= 80
        && data.supplier is string && data.supplier.size() >= 1 && data.supplier.size() <= 80
        && data.offerName is string && data.offerName.size() >= 1 && data.offerName.size() <= 100
        && data.kwh is number && data.kwh >= 0 && data.kwh <= 100000
        && data.punText is string && data.punText.size() <= 60
        && data.variableCostPerKwh is number && data.variableCostPerKwh >= 0 && data.variableCostPerKwh <= 10
        && data.canoneTv is number && data.canoneTv >= 0 && data.canoneTv <= 500
        && data.electricityOnly is number && data.electricityOnly >= 0 && data.electricityOnly <= 50000
        && data.totalPaid is number && data.totalPaid >= 0 && data.totalPaid <= 50000
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/electricityBills/{billId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(billId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(billId)
        && isValidElectricityBill(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(billId)
        && isValidElectricityBill(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'invoiceNumber', 'issueDate', 'sortKey', 'year', 'period', 'supplier',
          'offerName', 'kwh', 'punText', 'variableCostPerKwh', 'canoneTv',
          'electricityOnly', 'totalPaid', 'note', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(billId);
    }

    function isValidWaterBill(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'invoiceNumber', 'issueDate', 'year', 'period',
          'cubicMeters', 'fixedCostEur', 'totalPaid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'invoiceNumber', 'issueDate', 'year', 'period',
          'cubicMeters', 'fixedCostEur', 'totalPaid', 'note', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 40
        && data.issueDate is string && data.issueDate.size() >= 8 && data.issueDate.size() <= 20
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.period is string && data.period.size() >= 1 && data.period.size() <= 80
        && data.cubicMeters is number && data.cubicMeters >= 0 && data.cubicMeters <= 10000
        && data.fixedCostEur is number && data.fixedCostEur >= 0 && data.fixedCostEur <= 5000
        && data.totalPaid is number && data.totalPaid >= 0 && data.totalPaid <= 50000
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/waterBills/{billId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(billId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(billId)
        && isValidWaterBill(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(billId)
        && isValidWaterBill(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'invoiceNumber', 'issueDate', 'year', 'period', 'cubicMeters',
          'fixedCostEur', 'totalPaid', 'note', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(billId);
    }

    function isValidTariBill(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'noticeNumber', 'issueDate', 'dueDate', 'year',
          'period', 'supplier', 'totalPaid', 'paid', 'source', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'noticeNumber', 'issueDate', 'dueDate', 'year',
          'period', 'supplier', 'totalPaid', 'paid', 'source', 'note', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.noticeNumber is string && data.noticeNumber.size() >= 1 && data.noticeNumber.size() <= 50
        && data.issueDate is string && data.issueDate.size() >= 1 && data.issueDate.size() <= 20
        && data.dueDate is string && data.dueDate.size() >= 1 && data.dueDate.size() <= 20
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.period is string && data.period.size() >= 1 && data.period.size() <= 80
        && data.supplier is string && data.supplier.size() >= 1 && data.supplier.size() <= 80
        && data.totalPaid is number && data.totalPaid >= 0 && data.totalPaid <= 50000
        && data.paid is bool
        && data.source is string && data.source.size() <= 20 && data.source in ['gmail-pdf', 'manuale']
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/tariBills/{billId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(billId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(billId)
        && isValidTariBill(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(billId)
        && isValidTariBill(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'noticeNumber', 'issueDate', 'dueDate', 'year', 'period',
          'supplier', 'totalPaid', 'paid', 'source', 'note', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(billId);
    }

    function isValidGsePayment(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'paymentDate', 'year', 'paymentType', 'period', 'amountEur', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'paymentDate', 'year', 'paymentType', 'period',
          'amountEur', 'kwhInjected', 'reference', 'note', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.paymentDate is string && data.paymentDate.size() >= 1 && data.paymentDate.size() <= 20
        && data.year is number && data.year >= 2020 && data.year <= 2100
        && data.paymentType is string && data.paymentType.size() <= 24 && data.paymentType in ['acconto', 'conguaglio', 'altro']
        && data.period is string && data.period.size() >= 1 && data.period.size() <= 80
        && data.amountEur is number && data.amountEur >= 0 && data.amountEur <= 50000
        && (!('kwhInjected' in data) || (data.kwhInjected is number && data.kwhInjected >= 0 && data.kwhInjected <= 100000))
        && (!('reference' in data) || (data.reference is string && data.reference.size() <= 80))
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/gsePayments/{paymentId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(paymentId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(paymentId)
        && isValidGsePayment(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(paymentId)
        && isValidGsePayment(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'paymentDate', 'year', 'paymentType', 'period',
          'amountEur', 'kwhInjected', 'reference', 'note', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(paymentId);
    }

    function isValidHomeArticle(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'name', 'brand', 'model', 'category', 'room', 'familyWarranty', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'brand', 'model', 'category', 'room',
          'purchaseDate', 'warrantyEnd', 'familyWarranty', 'serialNumber',
          'specs', 'notes', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 60
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 80
        && data.category is string && data.category.size() <= 32
        && data.category in ['elettrodomestici', 'elettronica', 'sicurezza', 'fotovoltaico', 'clima', 'altro']
        && data.room is string && data.room.size() >= 1 && data.room.size() <= 60
        && (!('purchaseDate' in data) || (data.purchaseDate is string && data.purchaseDate.size() <= 20))
        && (!('warrantyEnd' in data) || (data.warrantyEnd is string && data.warrantyEnd.size() <= 20))
        && data.familyWarranty is bool
        && (!('serialNumber' in data) || (data.serialNumber is string && data.serialNumber.size() <= 80))
        && (!('specs' in data) || (data.specs is string && data.specs.size() <= 240))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 240))
        && data.createdAt is timestamp;
    }

    match /users/{userId}/homeArticles/{articleId} {
      allow get: if (isOwner(userId) || isPublicReadTarget(userId)) && isValidId(articleId);
      allow list: if isOwner(userId) || isPublicReadTarget(userId);
      allow create: if isOwner(userId)
        && isValidId(articleId)
        && isValidHomeArticle(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(articleId)
        && isValidHomeArticle(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'brand', 'model', 'category', 'room',
          'purchaseDate', 'warrantyEnd', 'familyWarranty', 'serialNumber',
          'specs', 'notes', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(articleId);
    }

    function isValidVaultFile(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'fileKey', 'fileName', 'mimeType', 'size', 'chunkCount', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'fileKey', 'fileName', 'mimeType', 'size', 'chunkCount', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.fileKey is string && data.fileKey.size() >= 1 && data.fileKey.size() <= 80 && data.fileKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 140
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 80
        && data.size is number && data.size >= 1 && data.size <= 6500000
        && data.chunkCount is number && data.chunkCount >= 1 && data.chunkCount <= 16
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/vaultFiles/{fileId} {
      allow get: if isOwner(userId) && isValidId(fileId);
      allow list: if isOwner(userId) && existing().ownerId == userId;
      allow create: if isOwner(userId)
        && isValidId(fileId)
        && isValidVaultFile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(fileId)
        && isValidVaultFile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().fileKey == existing().fileKey
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fileName', 'mimeType', 'size', 'chunkCount', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(fileId);
    }

    function isValidVaultFileChunk(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'fileKey', 'chunkIndex', 'data', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'fileKey', 'chunkIndex', 'data', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128
        && data.fileKey is string && data.fileKey.size() >= 1 && data.fileKey.size() <= 80 && data.fileKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.chunkIndex is number && data.chunkIndex >= 0 && data.chunkIndex <= 15
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 700000
        && data.createdAt is timestamp;
    }

    match /users/{userId}/vaultFileChunks/{chunkId} {
      allow get: if isOwner(userId) && isValidId(chunkId);
      allow list: if isOwner(userId) && existing().ownerId == userId;
      allow create: if isOwner(userId)
        && isValidId(chunkId)
        && isValidVaultFileChunk(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(chunkId)
        && isValidVaultFileChunk(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().fileKey == existing().fileKey
        && incoming().chunkIndex == existing().chunkIndex
        && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'data', 'createdAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(chunkId);
    }
  }
}
